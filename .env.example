# Copy to .env and fill once at the repository root. Never commit .env.
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_JWT_KEY_AT_LEAST_32_CHARS
JWT_ISSUER=ECommerce.AuthService
JWT_AUDIENCE=ECommerce.Clients
RABBITMQ_USERNAME=REPLACE_ME
RABBITMQ_PASSWORD=REPLACE_ME
RABBITMQ_URL=amqps://RABBITMQ_USERNAME:RABBITMQ_PASSWORD@RABBITMQ_HOST/RABBITMQ_VHOST
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
PAYMOB_API_KEY=REPLACE_ME
PAYMOB_HMAC_SECRET=REPLACE_ME
PAYMOB_TRANSACTION_ID=REPLACE_ME
PAYMOB_CARD_INTEGRATION_ID=REPLACE_ME
PAYMOB_WALLET_INTEGRATION_ID=REPLACE_ME
PAYMOB_KIOSK_INTEGRATION_ID=REPLACE_ME
PAYMOB_IFRAME_ID=REPLACE_ME
