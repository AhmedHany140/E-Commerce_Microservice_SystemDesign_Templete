{
  "ConnectionStrings": {
    "Constr": "Server=.;Database=ECommerceProductDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "ECommerce.AuthService",
    "Audience": "ECommerce.Clients"
  },
  "RabbitMQ": {
    "Enabled": false,
    "Host": "localhost",
    "Username": "RABBITMQ_USERNAME",
    "Password": "RABBITMQ_PASSWORD",
    "VirtualHost": "/"
  },
  "Wolverine": { "SqlPersistenceEnabled": true },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
