{
  "Jwt": {
    "Issuer": "ECommerce.AuthService",
    "Audience": "ECommerce.Clients"
  },
  "RateLimiting": { "PermitLimit": 100, "Window": "00:01:00" },
  "Cors": { "AllowedOrigins": [ "http://localhost:3000", "https://localhost:3000" ] },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "products": { "ClusterId": "products", "Match": { "Path": "/api/products/{**catch-all}" } },
      "cart": { "ClusterId": "cart", "Match": { "Path": "/api/carts/{**catch-all}" } },
      "orders": { "ClusterId": "orders", "Match": { "Path": "/api/orders/{**catch-all}" } },
      "payment": { "ClusterId": "payment", "Match": { "Path": "/api/payment/{**catch-all}" } },
      "graphql": { "ClusterId": "query", "Match": { "Path": "/graphql/{**catch-all}" } }
    },
    "Clusters": {
      "auth": { "Destinations": { "default": { "Address": "http://localhost:5051/" } } },
      "products": { "Destinations": { "default": { "Address": "http://localhost:5090/" } } },
      "cart": { "Destinations": { "default": { "Address": "http://localhost:5057/" } } },
      "orders": { "Destinations": { "default": { "Address": "http://localhost:5072/" } } },
      "payment": { "Destinations": { "default": { "Address": "http://localhost:5113/" } } },
      "query": { "Destinations": { "default": { "Address": "http://localhost:5008/" } } }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
