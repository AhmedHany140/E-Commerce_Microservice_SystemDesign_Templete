{
  "ConnectionStrings": {
    "Constr": "Server=.;Database=ECommerceAuthDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "ECommerce.AuthService",
    "Audience": "ECommerce.Clients"
  },
  "RabbitMq": {
    "Enabled": false,
    "Url": "amqp://RABBITMQ_USERNAME:RABBITMQ_PASSWORD@localhost:5672/"
  },
  "Wolverine": { "SqlPersistenceEnabled": true },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
